# Copy these keys into Streamlit Cloud → App settings → Secrets.
# Never commit your real secrets.toml file.

OPENAI_API_KEY = "replace-with-a-new-openai-api-key"
ASTRA_DB_APPLICATION_TOKEN = "replace-with-a-new-astra-token"
ASTRA_DB_API_ENDPOINT = "https://your-database-id-your-region.apps.astra.datastax.com"

# Optional settings
ASTRA_DB_COLLECTION = "pdf_chatbot_documents"
OPENAI_CHAT_MODEL = "gpt-4o-mini"
OPENAI_EMBEDDING_MODEL = "text-embedding-3-small"
